         return false;
       }
 
+      if (TraceRiscVVSetLICM) {
+        tty->print_cr("RiscVVSetLICM: loop head B%d: entry edge B%d succ %u slot #%u ctrl #%u",
+                      head->_pre_order, pred_block->_pre_order, succ_no,
