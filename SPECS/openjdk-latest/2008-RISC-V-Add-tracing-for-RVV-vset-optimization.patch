+
+static void trace_riscv_vset_state(const char* prefix, const RiscVVSetState& state) {
+  if (!TraceRiscVVSetLICM) {
+    return;
+  }
+  if (state._valid) {
+    tty->print("%s%s length=%u lmul=%d sew=%d vma=%d vta=%d",
