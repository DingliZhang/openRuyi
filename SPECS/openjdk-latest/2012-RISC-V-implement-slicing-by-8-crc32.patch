+  zext(tmp, tmp, 8);
+  shadd(tmp, tmp, table1, tmp, 2);
+  lwu(tmp, Address(tmp));
+  xorr(crc, crc, tmp);
+
+  srli(tmp, v, 56);
+  shadd(tmp, tmp, table0, tmp, 2);
+  lwu(tmp, Address(tmp));
