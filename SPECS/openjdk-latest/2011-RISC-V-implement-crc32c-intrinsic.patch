+void StubRoutines::riscv::generate_CRC32C_table() {
+  constexpr int table_size = 256;
+  constexpr int scalar_tables = 4;
+  constexpr int braid_tables = 4;
+  constexpr int N = 16;
+  constexpr int W = 4;
